<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car_bot_urdf">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import car_bot_urdf urdf file -->
    <xacro:include filename="$(find car_bot_urdf)/urdf/car_bot_moveit.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="car_bot_urdf.ros2_control.xacro" />


    <xacro:car_bot_urdf_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
