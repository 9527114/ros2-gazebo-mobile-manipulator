    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <ros>
        <remapping>cmd_vel:=/cmd_vel_nav</remapping>
      </ros>
      <update_rate>50.0</update_rate>

      <!-- 主动轮 -->
      <left_joint>wheel_lf_joint</left_joint>
      <right_joint>wheel_rf_joint</right_joint>

      <!-- 轮距与直径 -->
      <wheel_separation>0.066</wheel_separation>
      <wheel_diameter>0.03</wheel_diameter>

      <!-- 限制 -->
      <max_wheel_torque>1</max_wheel_torque>
      <max_wheel_acceleration>20.0</max_wheel_acceleration>

      <!-- 输出 -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
